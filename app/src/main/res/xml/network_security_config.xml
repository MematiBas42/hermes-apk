<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext stays permitted so users can point the Base URL at a self-hosted LAN server over
  http://. This is *not* a license for credentials in the clear: every interceptor refuses to
  attach an Authorization header unless the final URL is https, and the run prompt never embeds
  a plaintext file-service URL. An http:// server therefore only ever sees anonymous requests.
  The settings screen additionally warns when an http:// URL is configured.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
